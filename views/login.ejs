<%- include("./partials/header.ejs") %>

    <div id="successModal"
        class="fixed inset-0 bg-[#2B0404] bg-opacity-75 flex items-center justify-center z-50 hidden">
        <div
            class="bg-[#2B0404] rounded-lg p-12 shadow-lg relative border-[0.1875rem] border-[#DCDCDC] flex flex-col items-center max-w-2xl w-full">
            <button id="closeModal"
                class="absolute top-4 right-4 text-gray-400 hover:text-gray-500 text-4xl cursor-pointer">&times;</button>
            <p class="text-2xl font-light text-[#DCDCDC] text-center mb-3">Inloggning lyckades! 🎉</p>
            <p class="text-lg font-light text-[#DCDCDC] text-center mb-6">Välkommen tillbaka! Du kan nu gå till din
                profil.</p>
            <button id="redirectButton"
                class="bg-[#FFC342] hover:bg-[#FFB108] text-black font-bold rounded-lg text-lg px-8 py-3 text-center mb-4">
                Gå till din profil
            </button>
        </div>
    </div>

    <div class="flex bg-[#2B0404] min-h-screen w-full items-center justify-center p-4" id="loginForm">
        <div class="w-full max-w-md bg-[#2B0404] rounded-lg shadow border-[0.1875rem] border-[#DCDCDC] p-6 md:p-8">
            <h1 class="text-2xl md:text-3xl font-bold text-[#DCDCDC] text-center mb-8">
                Logga in
            </h1>
            <form class="space-y-6" action="#">
                <div>
                    <label for="email" class="block mb-2 text-sm font-medium text-[#DCDCDC]">
                        E-post
                    </label>
                    <input type="email" name="email" id="email"
                        class="w-full p-2.5 bg-gray-50 border border-gray-300 text-black rounded-lg focus:ring-primary-600 focus:border-primary-600"
                        placeholder="Skriv in e-post" required="" aria-invalid="false" aria-describedby="emailError">
                    <p id="emailError" class="text-red-500 text-sm mt-1 hidden" aria-live="assertive">Fel e-postadress
                    </p>
                </div>
                <div>
                    <label for="password" class="block mb-2 text-sm font-medium text-[#DCDCDC]">Lösenord</label>
                    <input type="password" name="password" id="password" placeholder="••••••••"
                        class="w-full p-2.5 bg-gray-50 border border-gray-300 text-black rounded-lg focus:ring-primary-600 focus:border-primary-600"
                        required="" aria-invalid="false" aria-describedby="passwordError">
                    <p id="passwordError" class="text-red-500 text-sm mt-1 hidden" aria-live="assertive">Fel lösenord.
                        Försök igen.</p>
                </div>
                <div class="flex items-center justify-between">
                    <a href="#" class="text-sm font-medium text-[#DCDCDC] underline">Glömt lösenord?</a>
                </div>
                <div class="flex flex-col items-center mt-6 space-y-4">
                    <button type="submit"
                        class="w-full sm:w-auto px-5 py-2.5 text-black bg-[#FFC342] hover:bg-[#FFB108] focus:ring-4 focus:outline-none focus:ring-[#a7c7ff] font-bold rounded-lg text-sm text-center">
                        Logga in
                    </button>
                    <p class="text-sm font-light text-[#DCDCDC] text-center">
                        Inte medlem? <a href="/signup" class="font-medium text-primary-700 hover:underline">Skapa
                            konto</a>
                    </p>
                </div>
            </form>
        </div>
    </div>

    <%- include("./partials/footer.ejs") %>
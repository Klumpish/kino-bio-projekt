<%- include("./partials/header.ejs") %>

<div class="flex bg- flex-col items-center justify-center px-6 py-8 mx-auto md:h-screen lg:py-0">
    <div class="w-full bg-white rounded-lg shadow border md:mt-0 sm:max-w-md xl:p-0">
        <div class="p-6 space-y-4 md:space-y-6 sm:p-8">
            <h1 class="text-xl font-bold leading-tight tracking-tight text-gray-900 md:text-2xl text-center">
                Logga in
            </h1>
            <form class="space-y-4 md:space-y-6 flex flex-col items-center" action="#">
                <div>
                    <label for="email" class="block mb-1 text-sm font-medium text-gray-900">E-post eller telefonnummer</label>
                    <input type="email" name="email" id="email" class="bg-gray-50 border border-gray-300 text-gray-900 rounded-lg focus:ring-primary-600 focus:border-primary-600 block w-full p-2.5" placeholder="name@company.com" required="">
                </div>
                <div>
                    <label for="password" class="block mb-2 text-sm font-medium text-gray-900">Lösenord</label>
                    <input type="password" name="password" id="password" placeholder="••••••••" class="bg-gray-50 border border-gray-300 text-gray-900 rounded-lg focus:ring-primary-600 focus:border-primary-600 block w-full p-2.5" required="">
                </div>
                <div class="flex items-center justify-between">
                    <div class="flex items-start">
                    </div>
                    <a href="#" class="text-sm font-medium color-[#1e40af] underline">Glömt lösenord?</a>
                </div>
                <!-- Button is centered within flex container -->
                <button type="submit" class="w-[14.125rem] text-black bg-[#FFC342] hover:bg-[#FFB108] focus:ring-4 focus:outline-none focus:ring-[#a7c7ff] font-bold rounded-lg text-m px-5 py-2.5 text-center">Logga in</button>
                <p class="text-sm font-light text-gray-500">
                    Inte medlem? <a href="#" class="font-medium text-primary-700 hover:underline">Skapa konto</a>
                </p>
            </form>
        </div>
    </div>
</div>

<%- include("./partials/footer.ejs") %>

<script>
document.getElementById("membership-link-main").addEventListener("click", function (e) {
  e.preventDefault();
  openModal("membershipModal");
});

document.getElementById("membership-link-hamburger").addEventListener("click", function (e) {
  e.preventDefault();
  openModal("membershipModal");
});

function openModal(modalId) {
  document.getElementById(modalId).style.display = "block";
}

function closeModal(modalId) {
  document.getElementById(modalId).style.display = "none";
}

function showSignup() {
  document.getElementById("signupFormContainer").style.display = "block";
  document.getElementById("loginFormContainer").style.display = "none";
  document.getElementById("authButtons").style.display = "none";
}

function showLogin() {
  document.getElementById("loginFormContainer").style.display = "block";
  document.getElementById("signupFormContainer").style.display = "none";
  document.getElementById("authButtons").style.display = "none"; 
}

function goBack() {
  document.getElementById("signupFormContainer").style.display = "none";
  document.getElementById("loginFormContainer").style.display = "none";
  document.getElementById("authButtons").style.display = "block";
}
// User puts in data when signing up. 
document.getElementById("signupForm").addEventListener("submit", function (e) {
  e.preventDefault();

  const username = e.target[0].value;
  const email = e.target[1].value;
  const fullName = e.target[2].value;
  const password = e.target[3].value;

  if (!isStrongPassword(password)) {
  alert("Lösenordet måste innehålla minst 8 tecken!");
  return;
}
  // Store user data in localStorage.
  localStorage.setItem("user", JSON.stringify({ username, email, fullName, password }));

  closeModal("membershipModal");
  window.location.href = "/profile";
});

function isStrongPassword(password) {
  return password.length >= 8;

  return "Bra";
}

document.getElementById("loginForm").addEventListener("submit", function (e) {
  e.preventDefault();

  // Get form data and check against localStorage.
  const username = e.target[0].value;
  const password = e.target[1].value;

  const user = JSON.parse(localStorage.getItem("user"));

  if (user && user.username === username && user.password === password) {
    closeModal("membershipModal");
    window.location.href = "/profile";
  } else {
    alert("Invalid username or password. Please try again.");
  }
});
</script>
<%- include("./partials/header.ejs") %>

  <!--Membership Modal -->
<div id="membershipModal" class="modal hidden">
  <div class="modal-content">
    <i class="close icon" onclick="closeModal('membershipModal')"></i>
    <h2 class="membership__h2">MEDLEMSKAP</h2>
    <div id="authButtons" class="ui inverted segment">
      <button class="ui circular inverted red button" onclick="showLogin()">Logga in</button>
      <button class="ui circular inverted red button" onclick="showSignup()">Registrera</button>
    </div>
    
    <!-- Signup Form -->
<div id="signupFormContainer" class="hidden">
  <h2 class="membership__info">Skapa Konto</h2>
  <form id="signupForm" class="ui form">
    <div class="field">
      <label>Användarnamn</label>
      <div class="ui input">
        <input type="text" placeholder="Användarnamn" required />
      </div>
    </div>

    <div class="field">
      <label>E-post</label>
      <div class="ui input">
        <input type="email" placeholder="E-post" required />
      </div>
    </div>

    <div class="field">
      <label>Fullständigt namn</label>
      <div class="ui input">
        <input type="text" placeholder="Fullständigt namn" required />
      </div>
    </div>

    <div class="field">
      <label>Lösenord</label>
      <div class="ui input">
        <input type="password" placeholder="Lösenord" required />
        <div id="passwordSafe"></div>
      </div>
    </div>
    <button type="button" class="ui button" onclick="goBack()">Tillbaka</button>
    <button type="submit" class="ui red basic button">Registrera</button>
  </form>
</div>

    <!-- Login Form -->
    <div id="loginFormContainer" class="hidden">
      <h2 class="membership__info">Logga in</h2>
      <form id="loginForm">
        <div class="field">
          <div class="ui input">
            <input type="text" placeholder="Användarnamn" required />
          </div>
        </div>        <div class="field">
          <div class="ui input">
            <input type="password" placeholder="Lösenord" required />
          </div>
        </div>
        <button type="button" class="ui button" onclick="goBack()">Tillbaka</button>
        <button type="submit" class="ui red basic button">Logga in</button>
      </form>
    </div>
  </div>
</div>



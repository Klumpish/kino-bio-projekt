<%- include("./partials/header.ejs") %>
<div id="membershipModal" class="ui modal">
  <div class="ui modal-content">
    <span class="close" onclick="closeModal('membershipModal')">&times;</span>
    <h2>Välj alternativ</h2>
    <button class="ui button" onclick="showSignup()">Registrera</button>
    <button class="ui button" onclick="showLogin()">Logga In</button>

    <!-- Signup Form -->
    <div id="signupFormContainer" class="hidden">
      <h2>Skapa Konto</h2>
      <form id="signupForm" class="ui form">
        <div class="field">
          <label>Användarnamn</label>
          <input type="text" placeholder="Användarnamn" required />
        </div>
        <div class="field">
          <label>E-post</label>
          <input type="email" placeholder="E-post" required />
        </div>
        <div class="field">
          <label>Fullständigt namn</label>
          <input type="text" placeholder="Fullständigt namn" required />
        </div>
        <div class="field">
          <label>Lösenord</label>
          <input type="password" placeholder="Lösenord" required />
        </div>
        <button type="submit" class="ui primary button">Registrera</button>
      </form>
    </div>

    <!-- Login Form -->
    <div id="loginFormContainer" class="hidden">
      <h2>Logga in</h2>
      <form id="loginForm" class="ui form">
        <div class="field">
          <label>Användarnamn</label>
          <input type="text" placeholder="Användarnamn" required />
        </div>
        <div class="field">
          <label>Lösenord</label>
          <input type="password" placeholder="Lösenord" required />
        </div>
        <button type="submit" class="ui primary button">Logga in</button>
      </form>
    </div>

    <!-- User Profile (after login/register) -->
    <div id="profileInfoContainer" class="hidden">
      <h2>Min Profil</h2>
      <p><strong>Användarnamn:</strong> <span id="profileUsername"></span></p>
      <p><strong>E-post:</strong> <span id="profileEmail"></span></p>
      <p><strong>Fullständigt namn:</strong> <span id="profileFullName"></span></p>
      <button class="ui red button" onclick="logout()">Logga ut</button>
    </div>
  </div>
</div>



